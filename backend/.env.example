# AFG Backend Configuration

# Persistence mode: 'sqlite' or 'supabase'
PERSISTENCE_MODE=sqlite

# LLM & AI Provider Configuration
# Supported providers: 'gemini', 'groq', 'nemotron', 'openai', 'fallback'
AI_PROVIDER=fallback

# API Keys (leave blank to use local fallback mode)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NEMOTRON_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
OPENAI_MODEL=gpt-4o-mini

# Embedding Model
EMBEDDING_PROVIDER=fallback
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase (optional, for hosted postgres / pgvector)
SUPABASE_URL=
SUPABASE_KEY=

